# Example environment variables required to run the app locally or on Render

# App runtime
APP_ENV=production

# Database
DB_HOST=127.0.0.1
DB_NAME=gccp
DB_USER=root
DB_PASS=secret
# Or optionally: DATABASE_URL=mysql://user:pass@host/dbname

# Server-side secret pepper (generate a long random string and keep it secret)
PASSWORD_PEPPER=replace-with-a-long-random-secret
